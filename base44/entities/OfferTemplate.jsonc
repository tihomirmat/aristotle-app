{
  "name": "OfferTemplate",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "service",
        "product",
        "saas",
        "custom"
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "scanned",
        "manual",
        "cloned",
        "design"
      ]
    },
    "source_file_id": {
      "type": "string"
    },
    "body_markdown": {
      "type": "string"
    },
    "body_styles": {
      "type": "object"
    },
    "design": {
      "type": "object",
      "description": "Dizajn izvirne ponudbe (PDF): slogi (pisava, velikost, barva, razmik), robovi, \u0161tevilka strani in izvirna vsebina kot primer (base44/shared/offerDesign.js)"
    },
    "letterhead_url": {
      "type": "string",
      "description": "PDF z izvirnimi stranmi brez besedila (glava, noga, ozadje) \u2014 podlaga za nove ponudbe"
    },
    "source_pdf_url": {
      "type": "string"
    },
    "design_fonts": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "[{ name, used, exact }] \u2014 katere pisave so bile najdene in s \u010dim so nadome\u0161\u010dene"
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "is_default": {
      "type": "boolean",
      "default": false
    },
    "owner_email": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "business_id",
    "name",
    "kind"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "owner_email": "{{user.email}}"
        },
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "owner_email": "{{user.email}}"
        },
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "owner_email": "{{user.email}}"
        },
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}