{
  "name": "Lead",
  "description": "Stranka (oseba) v CRM; lahko pripada podjetju (company_id)",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "form",
        "import",
        "chatbot",
        "manual",
        "email"
      ],
      "default": "manual"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "replied",
        "booked",
        "converted",
        "lost",
        "unsubscribed"
      ],
      "default": "new"
    },
    "consent_email": {
      "type": "boolean",
      "default": false
    },
    "booking_intent": {
      "type": "boolean",
      "default": false
    },
    "email_subject": {
      "type": "string",
      "description": "Zadeva zadnjega prejetega e-sporo\u010dila (vir email)"
    },
    "email_message_id": {
      "type": "string",
      "description": "Message-ID zadnjega prejetega e-sporo\u010dila (dedupe)"
    },
    "last_inbound_at": {
      "type": "string",
      "format": "date-time",
      "description": "Kdaj je stranka nazadnje pisala"
    },
    "service_requested": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_contacted_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    },
    "owner_email": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    },
    "company_id": {
      "type": "string",
      "description": "Podjetje, kateremu pripada stranka (neobvezno)"
    },
    "position": {
      "type": "string",
      "description": "Delovno mesto pri podjetju"
    },
    "value": {
      "type": "number",
      "description": "Vrednost posla v EUR"
    },
    "next_followup_at": {
      "type": "string",
      "format": "date-time",
      "description": "Naslednji korak"
    },
    "address": {
      "type": "string"
    }
  },
  "required": [
    "business_id",
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "owner_email": "{{user.email}}"
        },
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "owner_email": "{{user.email}}"
        },
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "owner_email": "{{user.email}}"
        },
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}