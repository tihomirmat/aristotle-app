{
  "name": "Activity",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string"
    },
    "lead_id": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "email_in",
        "email_out",
        "call",
        "meeting",
        "note",
        "sms",
        "chat",
        "form",
        "task_done",
        "offer",
        "booking",
        "system"
      ],
      "description": "Vrsta dogodka na časovnici stranke"
    },
    "direction": {
      "type": "string",
      "enum": [
        "inbound",
        "outbound",
        "internal"
      ],
      "default": "internal"
    },
    "subject": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "Kdaj se je zgodilo"
    },
    "is_automated": {
      "type": "boolean",
      "default": false
    },
    "draft_id": {
      "type": "string"
    },
    "offer_id": {
      "type": "string"
    },
    "booking_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "owner_email": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "business_id",
    "type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "owner_email": "{{user.email}}"
        },
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "owner_email": "{{user.email}}"
        },
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "owner_email": "{{user.email}}"
        },
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}