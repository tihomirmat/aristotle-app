{
  "name": "Send Email on Draft Approved",
  "description": "Triggers sendApprovedDraft whenever a DraftMessage status changes to \"approved\" \u2014 handles actual email delivery.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"approved\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "DraftMessage"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "send_email_on_draft_approved",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendApprovedDraft",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sendApprovedDraft"
  }
}