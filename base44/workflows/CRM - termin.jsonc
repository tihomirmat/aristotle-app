{
  "name": "CRM - termin",
  "description": "Potrjen termin zapi\u0161e na \u010dasovnico in stranko premakne v fazo Termin.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "ConfirmedBooking"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "crm_termin",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "crmEvents",
            "args": {
              "entity": "ConfirmedBooking"
            }
          },
          "then": "end"
        }
      }
    ]
  }
}